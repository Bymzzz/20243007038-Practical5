<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/color_defaultbackground">

    <!-- 顶部标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Municipalities in China"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/color_textdark"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>

    <!-- 中国地图图片 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:src="@drawable/chinese_municipalities"
        android:layout_marginBottom="20dp"/>

    <!-- 提示文字 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I want to know about:"
        android:textSize="22sp"
        android:textColor="@color/color_textdark"
        android:layout_marginBottom="8dp"/>

    <!-- 输入框 -->
    <EditText
        android:id="@+id/editTextMunicipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="name of a municipality"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionGo"
        android:textSize="22sp"
        android:layout_marginBottom="20dp"/>

</LinearLayout>